# --- Supabase (required to process worker tasks) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# Keep mock as the safe default. Set AI_PROVIDER=groq to use Groq.
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=none
GROQ_API_KEYS=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Optional xAI/Grok provider configuration:
XAI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_TOKEN_BUDGET_PER_RUN=100000

# --- Gmail (server only; automation and demos always use mock) ---
GMAIL_MODE=mock
GMAIL_MAX_MESSAGES_PER_IMPORT=10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/gmail/callback
# Generate each secret separately with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GMAIL_STATE_SECRET accepts canonical base64 containing at least 32 random bytes.
GMAIL_STATE_SECRET=
# GMAIL_TOKEN_ENC_KEY must be canonical base64 for exactly 32 random bytes.
GMAIL_TOKEN_ENC_KEY=

# --- Evidence access ---
SIGNED_URL_TTL_SECONDS=60
MAX_UPLOAD_MB=20

# --- App ---
APP_BASE_URL=http://localhost:3000
DEMO_MODE=false
